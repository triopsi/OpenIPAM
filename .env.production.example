# Optional: preserve the original key when upgrading an existing installation.
# With no explicit key, storage/app.key is generated once and reused.
APP_KEY=
APP_URL=https://ipam.example.com
APP_PORT=9080
OPENIPAM_IMAGE=ghcr.io/triopsi/openipam:latest
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
MAIL_MAILER=log
# Configure SMTP before using email two-factor authentication.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=ipam@example.com
